---
import "../styles/global.css";

interface Props {
  isResearch?: boolean;
}

const { isResearch = false } = Astro.props;
const homeTitle = "Nils Koster | Probabilistic Forecasting at KIT";
const researchTitle = "Research | Nils Koster";
const description = isResearch
  ? "Nils Koster’s research in probabilistic forecasting and statistical machine learning at KIT, with applications in weather and energy forecasting as well as metabolomics."
  : "Dr. Nils Koster works on probabilistic forecasting and statistical machine learning at Karlsruhe Institute of Technology.";
const researchPath = "/research/";
const canonical = Astro.site && new URL(isResearch ? researchPath : "/", Astro.site);
const sections = [
  { id: "research", label: "Research", href: researchPath },
  { id: "cv", label: "CV", href: "/#cv" },
  { id: "teaching", label: "Teaching", href: "/#teaching" },
  { id: "outside-work", label: "Outside work", href: "/#outside-work" },
  { id: "contact", label: "Contact", href: "/#contact" }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f4" />
    {canonical && <link rel="canonical" href={canonical.href} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{isResearch ? researchTitle : homeTitle}</title>
    <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="893ca80d-f9e9-4109-9162-9be09d838407"></script>
  </head>
  <body data-home-title={homeTitle} data-research-title={researchTitle}>
    <header>
      <a class="name" href="/">Nils Koster</a>
      <nav aria-label="Profile sections">
        <div class="profile-tabs" role="tablist" aria-label="Profile sections">
          {sections.map(({ id, label, href }, index) => (
            <a id={`tab-${id}`} href={href} role="tab" aria-controls={id} aria-selected={isResearch && id === "research"} data-tab={id} tabindex={index === 0 ? 0 : -1}>
              {label}
            </a>
          ))}
        </div>
      </nav>
    </header>

    <main id="top">
      <slot />
    </main>

    <footer>
      <span>Dr. Nils Koster</span>
      <span>Karlsruhe, Germany</span>
    </footer>

    <slot name="after-footer" />
  </body>
</html>
