---
import { getCollection } from "astro:content";
import InlineLinks from "./InlineLinks.astro";
import PaperPanel from "./PaperPanel.astro";
import ProfileLayout from "../layouts/ProfileLayout.astro";

interface Props {
  isResearch?: boolean;
}

const { isResearch = false } = Astro.props;

const papers = (await getCollection("papers"))
  .filter((paper) => !paper.data.draft)
  .sort((a, b) =>
    b.data.year - a.data.year ||
    b.data.order - a.data.order
  );

function joinAuthors(authors: string[]) {
  if (authors.length === 1) return authors[0];
  if (authors.length === 2) return `${authors[0]} and ${authors[1]}`;
  return `${authors.slice(0, -1).join(", ")} and ${authors.at(-1)}`;
}

function paperLinks(paper: (typeof papers)[number]) {
  const { links, codeUrl, paperUrl } = paper.data;
  const candidates = codeUrl ? [...links, { label: "Code", url: codeUrl }] : links;
  // The title already links to the paper; keep each other destination once.
  const seen = new Set([new URL(paperUrl).href]);
  return candidates.filter((link) => {
    const url = new URL(link.url).href;
    if (seen.has(url)) return false;
    seen.add(url);
    return true;
  });
}

const interactiveDemos = new Set(["random-forest", "forecast", "supermask"]);

const cvEntries = await getCollection("cv");
const cv = cvEntries[0];
const teaching = (await getCollection("teaching"))[0];

if (!teaching) throw new Error("The teaching content file is missing.");

if (!cv) {
  throw new Error("The public CV content file is missing.");
}
---

<ProfileLayout isResearch={isResearch}>
  <section class="intro" aria-label="About Nils Koster">
    <ul class="kicker" aria-label="Research interests">
      <li>Applied statistics</li>
      <li>Machine learning</li>
      <li>Probabilistic forecasting</li>
    </ul>
    <div class="intro-lower">
      <img class="portrait" src="/assets/nils-koster.webp" alt="Portrait of Nils Koster" width="720" height="900" />
      <div class="intro-details">
        <p>
          I am a researcher and lecturer at Karlsruhe Institute of Technology (KIT). I study how to build and evaluate probabilistic forecasts, with recent work on random forests and scoring rules.
        </p>
        <p class="links">
          <a href="/#contact" data-contact-link>Email</a>
          <a href="https://scholar.google.com/citations?user=OgmrRGIAAAAJ&amp;hl=de&amp;oi=sra" target="_blank" rel="noreferrer">Scholar</a>
          <a href="https://methods.stat.kit.edu/mitarbeiter_3248.php" target="_blank" rel="noreferrer">KIT</a>
          <a href="https://orcid.org/0009-0009-7189-0358" target="_blank" rel="noreferrer">ORCID</a>
          <a href="https://github.com/kosnil" target="_blank" rel="noreferrer">GitHub</a>
        </p>
      </div>
    </div>
  </section>

  <div class="tab-region" hidden={!isResearch}>
    <div id="research" role="tabpanel" aria-labelledby="tab-research" tabindex="0" hidden={!isResearch}>
      <section class="research-page research-intro" aria-labelledby="research-heading">
        <div class="section-label">
          <h1 id="research-heading">Research</h1>
        </div>
        <div class="section-content research-text">
          <p>I work on probabilistic forecasting and statistical machine learning at Karlsruhe Institute of Technology (KIT), with applications in weather and energy forecasting as well as metabolomics.</p>
        </div>
      </section>

      <section id="work" class="research-page research-publications" aria-labelledby="work-heading">
        <div class="section-label">
          <h2 id="work-heading">Papers &amp; Projects</h2>
        </div>
        <div class="section-content publications">
          {papers.map((paper) => (
            <div class="publication">
              <a class="publication-paper" href={paper.data.paperUrl} target="_blank" rel="noreferrer">
                <span class="publication-title">{paper.data.title}</span>
                <span class="publication-meta">
                  <span>{paper.data.venue}, {paper.data.year}</span>
                  {paper.data.authors.length > 0 && <span>With {joinAuthors(paper.data.authors)}</span>}
                </span>
              </a>
              <div class="publication-actions">
                {interactiveDemos.has(paper.data.visualization) && (
                  <div class="publication-demo">
                    <button type="button" data-open-paper={paper.id} data-open-demo aria-label={`Try the demo for ${paper.data.title}`}>[try the demo]</button>
                  </div>
                )}
                {paperLinks(paper).map((link) => (
                  <a href={link.url} target="_blank" rel="noreferrer">[{link.label.toLowerCase()}]</a>
                ))}
                <button type="button" data-open-paper={paper.id} aria-label={`Details for ${paper.data.title}`}>[Details]</button>
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>

    <section id="cv" class="tab-panel" role="tabpanel" aria-labelledby="tab-cv" tabindex="0" hidden>
      <div class="section-label">
        <h2>CV</h2>
      </div>
      <div class="section-content cv-content">
        {cv.data.groups.map((group) => (
          <div class="cv-group">
            <h3>{group.heading}</h3>
            {group.entries && (
              <div class="cv-entries">
                {group.entries.map((entry) => (
                  <div class="cv-entry">
                    <span>{entry.period}</span>
                    <div>
                      <strong>{entry.title}</strong>
                      <p><InlineLinks text={entry.detail} /></p>
                    </div>
                  </div>
                ))}
              </div>
            )}
            {group.notes && (
              <div class="cv-entries cv-notes">
                {group.notes.map((note) => <p><InlineLinks text={note} /></p>)}
              </div>
            )}
            {group.sections && (
              <div class="cv-subgroups">
                {group.sections.map((section) => (
                  <div class="cv-subgroup">
                    <h4>{section.heading}</h4>
                    {section.notes && (
                      <div class="cv-entries cv-notes">
                        {section.notes.map((note) => <p><InlineLinks text={note} /></p>)}
                      </div>
                    )}
                    {section.entries && (
                      <div class="cv-entries">
                        {section.entries.map((entry) => (
                          <div class="cv-entry">
                            <span>{entry.period}</span>
                            <div>
                              <strong>
                                {entry.title}
                                {entry.titleNote && <span class="cv-title-note"><InlineLinks text={entry.titleNote} /></span>}
                              </strong>
                              <p><InlineLinks text={entry.detail} /></p>
                            </div>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <section id="teaching" class="tab-panel" role="tabpanel" aria-labelledby="tab-teaching" tabindex="0" hidden>
      <div class="section-label"><h2>Teaching</h2></div>
      <div class="section-content teaching-content">
        <p>{teaching.data.intro}</p>
        <div class="teaching-courses">
          {teaching.data.courses.map((course) => (
            <div class="teaching-course">
              <h3><a href={course.url} target="_blank" rel="noreferrer">{course.title}</a></h3>
              <p>{course.role}, {course.period}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="outside-work" class="tab-panel outside-work" role="tabpanel" aria-labelledby="tab-outside-work" tabindex="0" hidden>
      <div class="section-label"><h2>Outside work</h2></div>
      <div class="section-content">
        <p>I teach gliding and fly in competitions. I also like taking photos and lead group kettlebell sessions.</p>
        <div class="outside-work-gallery" role="group" aria-label="Gliding and photography">
          <div class="outside-work-row">
            <img src="/assets/outside-work/glider-cockpit.webp" alt="A smiling pilot in a glider with the canopy open" width="1120" height="746" loading="lazy" decoding="async" />
            <img src="/assets/outside-work/glider-wingtip.webp" alt="A glider wingtip beside a rocky mountain ridge" width="1120" height="746" loading="lazy" decoding="async" />
          </div>
          <div class="outside-work-row outside-work-row--mixed">
            <img src="/assets/outside-work/hillside-tree.webp" alt="A lone tree on a golden slope with blue mountains in the distance" width="1120" height="746" loading="lazy" decoding="async" />
            <img src="/assets/outside-work/beach-chairs.webp" alt="Sunlit wicker beach chairs seen through dune grass" width="800" height="1200" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="tab-panel contact" role="tabpanel" aria-labelledby="tab-contact" tabindex="0" hidden>
      <div class="section-label">
        <h2>Contact</h2>
      </div>
      <div class="section-content">
        <p>I'm always interested in thoughtful conversations.</p>
        <form class="contact-form" action="https://formspree.io/f/moedbzjz" method="post" aria-label="Contact form">
          <label>
            Your email
            <input type="email" name="email" autocomplete="email" required />
          </label>
          <label>
            Message
            <textarea name="message" rows="5" required></textarea>
          </label>
          <button type="submit">Send message</button>
          <p>Submissions are handled by <a href="https://formspree.io/legal/privacy-policy/">Formspree</a>.</p>
        </form>
      </div>
    </section>
  </div>

  <Fragment slot="after-footer">
    <PaperPanel papers={papers} />
    <script src="../profile-tabs.js"></script>
    <script src="../scripts.js"></script>
  </Fragment>
</ProfileLayout>
